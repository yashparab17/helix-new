# Copy this file to .env and fill in values before deploying.
#
# For LOCAL Anvil testing you can safely use Anvil's default account #0
# private key, which is printed to your terminal when you run `anvil`:
#   PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
# NEVER put a real mainnet/testnet private key with real funds in this file.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
RPC_URL=http://127.0.0.1:8545
