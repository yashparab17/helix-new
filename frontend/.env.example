# Copy this file to .env before running `npm run dev`.

# Pinata: create a JWT at https://app.pinata.cloud/developers/api-keys
# (needs "pinFileToIPFS" permission).
VITE_PINATA_JWT=

# Public gateway used to fetch/download pinned files. Pinata's default
# public gateway works out of the box; use your own dedicated gateway if
# you have one.
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# JSON-RPC URL for the chain the frontend talks to. Defaults to a local
# Anvil node.
VITE_RPC_URL=http://127.0.0.1:8545

# Address of the deployed Helix contract (printed by `forge script Deploy`).
VITE_HELIX_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa

# WalletConnect Cloud project ID, used by RainbowKit. Get one free at
# https://cloud.walletconnect.com. Optional for pure-MetaMask local use,
# but recommended.
VITE_WALLETCONNECT_PROJECT_ID=
